<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- File purpose: Declares requested sandbox permissions for network access, user files, downloads, camera, and microphone. This file grants no permission by itself. The signing script must attach it; the current ad-hoc fallback does not attach it. -->
<plist version="1.0">
<dict>
	<!-- macOS App Sandbox -->
	<!-- Slate note: Enable App Sandbox only when this entitlement is included in the effective signed
	     application. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Outgoing network connections for web browsing -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- User-authorized file access (uploads, downloads destination selection) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Downloads folder access for downloaded files -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>

	<!-- Media device access after explicit user authorization -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- WebKit's native PiP window and Sparkle's own installer/status channels.
	     Keep the list specific; never grant a global Mach-service wildcard.
	     References: WebKit Tools/MiniBrowser/MiniBrowser.entitlements and
	     https://sparkle-project.org/documentation/sandboxing/ -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.PIPAgent</string>
		<string>dev.slate.browser-spki</string>
		<string>dev.slate.browser-spks</string>
	</array>

	<!-- Printing pages -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
